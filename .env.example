# AMEZA Multi-Vendor Marketplace Environment Variables (Australia)

# Backend Service Configuration (Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-migrations-and-cron

# Local Server Configuration
PORT=3000
NODE_ENV=development

# Marketplace Business Engine Defaults (Australia)
BASE_CURRENCY=AUD
STORE_COUNTRY=AU
DEFAULT_COMMISSION_PCT=10
PAYOUT_HOLD_DAYS=7
MIN_PAYOUT_AMOUNT_CENTS=5000  # AU$50.00

# Payment & Payout Gateways (Australia)
ENABLE_STRIPE=true
ENABLE_AU_BANK_PAYOUTS=true  # BSB & Account No / PayID
ENABLE_PAYPAL_AU=true
ENABLE_COD=false             # Optional toggle

# Moderation Rules
AUTO_APPROVE_SELLERS=false
AUTO_APPROVE_TRUSTED_PRODUCTS=true

# Travel & Flights Integration (FlightAPI.io)
FLIGHT_API_KEY=

